# Riot Developer Portal: https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Unix-Timestamp in Sekunden (hier: 01.10.2026 00:00 MESZ)
CHALLENGE_START_TIMESTAMP=1790805600
# Optional: Ende der Challenge, danach gespielte Matches zählen nicht mehr
# CHALLENGE_END_TIMESTAMP=1796079599

PORT=3001
# Origin des Frontends für CORS, z. B. http://localhost:5173
ALLOWED_ORIGIN=*
# Optional: schützt POST /api/refresh, Frontend sendet dann Header X-Refresh-Token
# REFRESH_TOKEN=
# Beim Serverstart automatisch aktualisieren (Cooldown wird beachtet)
REFRESH_ON_START=false
# Ordner für cache.json, matches_db.json und results.json
# DATA_DIR=./data
